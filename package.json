{
  "name": "gear",
  "displayName": "Gear - Spotlight & Command Palette",
  "description": "Fast, keyboard-first Spotlight search and command palette for browsers (Chrome and Firefox).",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:firefox": "vite --mode firefox",
    "build": "tsc -b && vite build --mode chrome && vite build --mode firefox",
    "build:chrome": "tsc -b && vite build --mode chrome",
    "build:firefox": "tsc -b && vite build --mode firefox",
    "lint:firefox": "npx web-ext lint --source-dir dist/firefox",
    "preview": "vite preview",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
